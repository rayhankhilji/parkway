{
  "name": "parkway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @parkway/web dev",
    "build": "pnpm --filter @parkway/web build",
    "test": "vitest run --project engine --project web",
    "test:engine": "vitest run --project engine",
    "test:web": "vitest run --project web",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "db:migrate": "supabase db push",
    "test:fuzz": "PARKWAY_FUZZ=full vitest run --project fuzz",
    "test:fuzz:quick": "vitest run --project fuzz"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@next/eslint-plugin-next": "15.1.6",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "prettier": "^3.4.2",
    "supabase": "^2.2.1",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.19.0",
    "vitest": "^3.0.0"
  }
}
