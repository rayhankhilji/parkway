# Copy to .env.local and fill in from your Supabase project settings.

# Browser-visible. Used only to open a Realtime subscription.
# Row-level security grants the anon role no table access whatsoever,
# so this key cannot read or write any data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Bypasses row-level security and is the sole means of data access.
# Never give this a NEXT_PUBLIC_ prefix and never import it into client code.
SUPABASE_SERVICE_ROLE_KEY=

# Origin used to build shareable join links, e.g. http://localhost:3000
NEXT_PUBLIC_APP_URL=
